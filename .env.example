# Copy to .env.local / Vercel project env. Do not commit secrets.

# Public site URL (canonical links on Vercel)
SITE_URL=

# Real 302 tracking number. Leave empty to keep the reserved placeholder in config.php.
# Example: PHONE_DISPLAY=(302) 555-0100 is NOT a production number.
PHONE_DISPLAY=
PHONE_TEL=

# Public contact mailbox
SITE_EMAIL=

# Optional JSON webhook for form + chatbot leads
FORM_WEBHOOK=

# Optional wording rewrite only. Chatbot works without this.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_BASE_URL=https://api.openai.com/v1
# Or Vercel AI Gateway:
# AI_GATEWAY_API_KEY=
