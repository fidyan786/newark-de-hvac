# Canonical origin for metadata, sitemap, Open Graph, and robots.
# Use the public production hostname. Do not use unique preview URLs
# (project-hash-team.vercel.app). When a custom domain is attached, set this
# to https://that-domain.tld — preview deployments will still canonicalize here.
NEXT_PUBLIC_SITE_URL=https://newark-de-hvac.vercel.app
NEXT_PUBLIC_PHONE_DISPLAY=
NEXT_PUBLIC_PHONE_TEL=
NEXT_PUBLIC_EMAIL=
NEXT_PUBLIC_ADDRESS=
NEXT_PUBLIC_HOURS=
NEXT_PUBLIC_EMERGENCY=false
NEXT_PUBLIC_LEGAL_NAME=Newark HVAC Pros
NEXT_PUBLIC_GA4=
FORM_WEBHOOK=
SECURITY_CONTACT_EMAIL=
LEAD_FILE_STORE=

# Optional chatbot wording polish (works without this; keys stay server-side)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_BASE_URL=https://api.openai.com/v1
